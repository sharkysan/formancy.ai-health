node_modules/
dist/
build/
# build/ above is a build's output. The demo's build plugin is source, in a
# directory of that name (0012), and is committed.
!apps/demo/src/build/
coverage/
.turbo/
*.tsbuildinfo
.env
.env.*
!.env.example
.DS_Store
*.log
.vitest-reports/
test-results/
# The release report's inputs and output (formancy.ai-report 0014): each
# job's collected results, the report built from them, and the tarballs the
# install gate packed. Build outputs of a run, never committed.
/release-results/
/release-report/
/release-tarballs/
.idea/
.pnpm-store/

# Copied into each package at build time by scripts/sync-licenses.mjs so the
# tarballs carry them. The root LICENSE.md and NOTICE are the only real ones.
packages/*/LICENSE.md
packages/*/NOTICE

/.claude

# What the validator gate downloads and unpacks (0005): the HL7 FHIR
# validator's JAR, the guide packages it loads and its package cache. Each is
# fetched by exact version and checked against the SHA-256 that
# docs/release/validator.json or docs/release/ig-packages.json registers, and
# none is ever committed.
/.fhir-cache/

# The delivery plan this repository started from. Kept locally for reference,
# never committed: it is a working document, not a record.
docs/plan.md

# The demo's build staged under its path for Wrangler, and Wrangler's own
# state (0012). Written by scripts/demo.mjs and removed after it.
/apps/demo/.cloudflare/
.wrangler/
